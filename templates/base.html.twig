<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}CityLunch{% endblock %}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        <link rel="stylesheet" href="/css/citylunch.css">
        {% block stylesheets %}{% endblock %}
    </head>
    <body>

        {# ── Navbar ── #}
        <nav class="navbar navbar-expand-lg cl-navbar">
            <div class="container">
                <a class="navbar-brand" href="{{ path('app_menu') }}">
                    <i class="bi bi-bag-heart-fill me-1" style="color: var(--cl-primary-light)"></i>
                    City<span>Lunch</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto ms-3">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_menu') }}">
                                <i class="bi bi-grid me-1"></i>Menu du jour
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-center gap-1">
                        {% if app.user %}
                            {# Panier #}
                            <li class="nav-item">
                                <a class="nav-link cart-btn" href="{{ path('app_cart') }}">
                                    <i class="bi bi-bag fs-6"></i>
                                    <span>Panier</span>
                                    {% set cartCount = app.user.cart ? app.user.cart.countItems() : 0 %}
                                    {% if cartCount > 0 %}
                                        <span class="cart-badge">{{ cartCount }}</span>
                                    {% endif %}
                                </a>
                            </li>
                            {# Compte #}
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" data-bs-toggle="dropdown">
                                    <span class="d-inline-flex align-items-center justify-content-center rounded-circle fw-bold"
                                          style="width:30px;height:30px;background:var(--cl-primary);color:#fff;font-size:.8rem">
                                        {{ app.user.firstName|slice(0,1)|upper }}
                                    </span>
                                    <span>{{ app.user.firstName }}</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li class="px-3 py-2 border-bottom mb-1">
                                        <div class="fw-semibold small">{{ app.user.firstName }} {{ app.user.lastName }}</div>
                                        <div class="text-muted" style="font-size:.78rem">{{ app.user.email }}</div>
                                    </li>
                                    <li>
                                        <a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                                            <i class="bi bi-box-arrow-right me-2"></i>Déconnexion
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        {% else %}
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('app_login') }}">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Connexion
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary-cl btn-sm px-3" href="{{ path('app_register') }}">
                                    Créer un compte
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </nav>

        {# ── Contenu ── #}
        <main class="container py-4">
            {% block body %}{% endblock %}
        </main>

        {# ── Footer ── #}
        <footer class="cl-footer">
            <div class="container d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span>
                    <i class="bi bi-bag-heart-fill me-1" style="color:var(--cl-primary)"></i>
                    <strong style="color:rgba(255,255,255,.7)">CityLunch</strong>
                    &mdash; Livraison de plats du jour
                </span>
                <span>&copy; {{ "now"|date("Y") }}</span>
            </div>
        </footer>

        {# ── Toast container ── #}
        <div class="toast-container" id="toastContainer">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    {% set icon = type == 'success' ? 'bi-check-circle-fill'
                        : (type == 'warning' ? 'bi-exclamation-triangle-fill'
                        : (type == 'error' or type == 'danger' ? 'bi-x-circle-fill'
                        : 'bi-info-circle-fill')) %}
                    <div class="cl-toast {{ type }}" role="alert">
                        <i class="bi {{ icon }} cl-toast-icon"></i>
                        <span class="cl-toast-msg">{{ message }}</span>
                        <button type="button" class="btn-close btn-close-sm ms-2 mt-1"
                                style="font-size:.65rem" onclick="this.closest('.cl-toast').remove()"></button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            // Auto-show et auto-dismiss des toasts
            document.addEventListener('DOMContentLoaded', () => {
                document.querySelectorAll('.cl-toast').forEach((toast, i) => {
                    setTimeout(() => {
                        toast.classList.add('show');
                        setTimeout(() => {
                            toast.classList.remove('show');
                            setTimeout(() => toast.remove(), 300);
                        }, 4000);
                    }, i * 150);
                });
            });
        </script>
        {% block javascripts %}{% endblock %}
    </body>
</html>
