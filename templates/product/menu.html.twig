{% extends 'base.html.twig' %}

{% block title %}Menu du {{ date|date('d/m/Y') }} — CityLunch{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 fw-bold mb-0">Menu du jour</h1>
            <p class="text-muted mb-0">{{ date|date('l d MMMM yyyy')|capitalize }}</p>
        </div>
    </div>

    {% if plats is empty and desserts is empty %}
        <div class="text-center py-5">
            <i class="bi bi-emoji-frown display-1 text-muted"></i>
            <p class="lead mt-3 text-muted">Aucun plat disponible aujourd'hui.</p>
        </div>
    {% else %}

        {% if plats is not empty %}
            <h2 class="h4 fw-semibold mb-3">
                <i class="bi bi-egg-fried text-warning me-2"></i>Plats
            </h2>
            <div class="row g-4 mb-5">
                {% for plat in plats %}
                    {{ _self.product_card(plat) }}
                {% endfor %}
            </div>
        {% endif %}

        {% if desserts is not empty %}
            <h2 class="h4 fw-semibold mb-3">
                <i class="bi bi-cake2 text-warning me-2"></i>Desserts
            </h2>
            <div class="row g-4">
                {% for dessert in desserts %}
                    {{ _self.product_card(dessert) }}
                {% endfor %}
            </div>
        {% endif %}

    {% endif %}
{% endblock %}

{% macro product_card(product) %}
    <div class="col-sm-6 col-lg-4">
        <div class="card h-100 shadow-sm border-0">
            <div class="card-body d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h5 class="card-title fw-semibold mb-0">{{ product.name }}</h5>
                    <span class="badge bg-warning text-dark ms-2 flex-shrink-0">
                        {{ product.priceFormatted }}
                    </span>
                </div>
                <p class="card-text text-muted small flex-grow-1">{{ product.description }}</p>
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <span class="text-muted small">
                        <i class="bi bi-box-seam me-1"></i>
                        {% if product.stock > 0 %}
                            {{ product.stock }} restant{{ product.stock > 1 ? 's' : '' }}
                        {% else %}
                            <span class="text-danger">Épuisé</span>
                        {% endif %}
                    </span>
                    {% if product.stock > 0 %}
                        {% if app.user %}
                            <form method="post" action="{{ path('app_cart_add', {productId: product.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('cart_add') }}">
                                <button type="submit" class="btn btn-dark btn-sm">
                                    <i class="bi bi-cart-plus me-1"></i>Ajouter
                                </button>
                            </form>
                        {% else %}
                            <a href="{{ path('app_login') }}" class="btn btn-outline-dark btn-sm">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Se connecter
                            </a>
                        {% endif %}
                    {% else %}
                        <button class="btn btn-secondary btn-sm" disabled>Épuisé</button>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endmacro %}
