{% extends 'base.html.twig' %}

{% block title %}Créer un compte — CityLunch{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h1 class="h3 fw-bold mb-1">Créer un compte</h1>
                    <p class="text-muted mb-4">Rejoignez CityLunch pour commander vos plats du jour.</p>

                    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}

                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                {{ form_label(form.firstName, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                                {{ form_widget(form.firstName, {attr: {class: 'form-control' ~ (form.firstName.vars.errors|length ? ' is-invalid' : '')}}) }}
                                {{ form_errors(form.firstName) }}
                            </div>
                            <div class="col-6">
                                {{ form_label(form.lastName, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                                {{ form_widget(form.lastName, {attr: {class: 'form-control' ~ (form.lastName.vars.errors|length ? ' is-invalid' : '')}}) }}
                                {{ form_errors(form.lastName) }}
                            </div>
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.email, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.email, {attr: {class: 'form-control' ~ (form.email.vars.errors|length ? ' is-invalid' : '')}}) }}
                            {{ form_errors(form.email) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.plainPassword.first, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.plainPassword.first, {attr: {class: 'form-control' ~ (form.plainPassword.vars.errors|length ? ' is-invalid' : '')}}) }}
                        </div>

                        <div class="mb-4">
                            {{ form_label(form.plainPassword.second, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.plainPassword.second, {attr: {class: 'form-control' ~ (form.plainPassword.vars.errors|length ? ' is-invalid' : '')}}) }}
                            {% if form.plainPassword.vars.errors|length %}
                                <div class="invalid-feedback d-block">
                                    {% for error in form.plainPassword.vars.errors %}
                                        {{ error.message }}
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-dark btn-lg">
                                <i class="bi bi-person-plus me-1"></i>Créer mon compte
                            </button>
                        </div>

                    {{ form_end(form) }}

                    <p class="text-center text-muted mb-0 small">
                        Déjà un compte ?
                        <a href="{{ path('app_login') }}" class="text-dark fw-semibold">Se connecter</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
