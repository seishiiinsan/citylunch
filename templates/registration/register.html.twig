{% extends 'base.html.twig' %}

{% block title %}Créer un compte — CityLunch{% endblock %}

{% block body %}
    <div class="auth-wrapper">
        <div style="width:100%;max-width:480px">
            <div class="auth-card">
                {# En-tête coloré #}
                <div class="auth-card-header">
                    <div class="mb-3" style="font-size:2rem">👋</div>
                    <h1>Créer un compte</h1>
                    <p>Rejoignez CityLunch pour commander vos plats du jour</p>
                </div>

                {# Formulaire #}
                <div class="auth-card-body">
                    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}

                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                {{ form_label(form.firstName, null, {label_attr: {class: 'form-label'}}) }}
                                {{ form_widget(form.firstName, {attr: {
                                    class: 'form-control' ~ (form.firstName.vars.errors|length ? ' is-invalid' : '')
                                }}) }}
                                {% if form.firstName.vars.errors|length %}
                                    <div class="invalid-feedback">
                                        {% for e in form.firstName.vars.errors %}{{ e.message }}{% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                            <div class="col-6">
                                {{ form_label(form.lastName, null, {label_attr: {class: 'form-label'}}) }}
                                {{ form_widget(form.lastName, {attr: {
                                    class: 'form-control' ~ (form.lastName.vars.errors|length ? ' is-invalid' : '')
                                }}) }}
                                {% if form.lastName.vars.errors|length %}
                                    <div class="invalid-feedback">
                                        {% for e in form.lastName.vars.errors %}{{ e.message }}{% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.email, null, {label_attr: {class: 'form-label'}}) }}
                            {{ form_widget(form.email, {attr: {
                                class: 'form-control' ~ (form.email.vars.errors|length ? ' is-invalid' : '')
                            }}) }}
                            {% if form.email.vars.errors|length %}
                                <div class="invalid-feedback">
                                    {% for e in form.email.vars.errors %}{{ e.message }}{% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.plainPassword.first, null, {label_attr: {class: 'form-label'}}) }}
                            {{ form_widget(form.plainPassword.first, {attr: {
                                class: 'form-control' ~ (form.plainPassword.vars.errors|length ? ' is-invalid' : '')
                            }}) }}
                        </div>

                        <div class="mb-4">
                            {{ form_label(form.plainPassword.second, null, {label_attr: {class: 'form-label'}}) }}
                            {{ form_widget(form.plainPassword.second, {attr: {
                                class: 'form-control' ~ (form.plainPassword.vars.errors|length ? ' is-invalid' : '')
                            }}) }}
                            {% if form.plainPassword.vars.errors|length %}
                                <div class="invalid-feedback d-block">
                                    {% for e in form.plainPassword.vars.errors %}{{ e.message }}{% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <button type="submit" class="btn btn-primary-cl w-100 py-2 mb-3">
                            <i class="bi bi-person-plus me-1"></i>Créer mon compte
                        </button>

                    {{ form_end(form) }}

                    <p class="text-center text-muted mb-0 small">
                        Déjà un compte ?
                        <a href="{{ path('app_login') }}" class="fw-semibold" style="color:var(--cl-primary)">
                            Se connecter
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
